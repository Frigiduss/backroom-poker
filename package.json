{
  "name": "poker",
  "version": "0.1.0",
  "private": true,
  "description": "Browser poker with bot opponents: Hold'em, Omaha, Draw, Stud and more.",
  "type": "module",
  "scripts": {
    "start": "node scripts/build.mjs --open",
    "prestart": "npm install --no-audit --no-fund --loglevel=error",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --serve",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs --test"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "esbuild": "0.25.10",
    "typescript": "5.6.3"
  }
}
